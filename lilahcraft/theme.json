{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "charcoal",
          "name": "Charcoal",
          "color": "#26242b"
        },
        {
          "slug": "charcoal-2",
          "name": "Charcoal line",
          "color": "#3a3740"
        },
        {
          "slug": "purple",
          "name": "Purple",
          "color": "#6c46e0"
        },
        {
          "slug": "purple-deep",
          "name": "Deep purple",
          "color": "#4b2fa8"
        },
        {
          "slug": "pink",
          "name": "Pink",
          "color": "#ff5fa8"
        },
        {
          "slug": "orange",
          "name": "Orange",
          "color": "#ff8a2b"
        },
        {
          "slug": "page",
          "name": "Page",
          "color": "#f5f4f7"
        },
        {
          "slug": "light",
          "name": "Light gray",
          "color": "#ecebef"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5f5c66"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Figtree",
          "fontFamily": "\"Figtree\", system-ui, sans-serif"
        },
        {
          "slug": "display",
          "name": "Unbounded",
          "fontFamily": "\"Unbounded\", system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "JetBrains Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, monospace"
        },
        {
          "slug": "pixel",
          "name": "Silkscreen",
          "fontFamily": "\"Silkscreen\", \"Courier New\", monospace"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#f5f4f7",
      "text": "#26242b"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)"
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "news-sidebar",
      "title": "News sidebar",
      "area": "uncategorized"
    }
  ]
}
